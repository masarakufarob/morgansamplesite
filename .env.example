# Morgan Zintec College - Environment Variables
# Copy this file to .env and fill in your values

# Site Configuration
SITE_URL=https://morganzintec.ac.zw

# Formspree Form Endpoints (create forms at formspree.io)
FORMSPREE_CONTACT_FORM=your-contact-form-id
FORMSPREE_RESEARCH_FORM=your-research-form-id

# Netlify Identity (for Decap CMS)
NETLIFY_IDENTITY_URL=https://your-site.netlify.app/.netlify/identity

# Analytics (optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX