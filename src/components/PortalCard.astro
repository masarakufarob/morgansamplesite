---
interface Props {
  title: string;
  description: string;
  icon: string;
  href: string;
  buttonText: string;
  buttonIcon?: string;
  gradient?: 'blue' | 'teal' | 'navy';
  className?: string;
}
const { title, description, icon, href, buttonText, buttonIcon, gradient = 'blue', className = '' } = Astro.props;

const gradientClasses = {
  blue: 'bg-gradient-to-br from-mzc-blue to-[#1C90D8]',
  teal: 'bg-gradient-to-br from-mzc-teal to-[#5AB8C4]',
  navy: 'bg-gradient-to-br from-mzc-navy to-[#3A5A8A]'
};

const buttonClasses = {
  blue: 'btn-primary',
  teal: 'btn-secondary',
  navy: 'btn-navy'
};
---

<div class={`portal-argon-card rounded-2xl overflow-hidden transition-all duration-300 cursor-pointer shadow-[0_15px_35px_rgba(50,50,93,.1),0_5px_15px_rgba(0,0,0,.07)] hover:-translate-y-2 hover:shadow-[0_30px_60px_rgba(50,50,93,.15),0_10px_20px_rgba(0,0,0,.1)] ${className}`}>
  <div class={`pac-header ${gradientClasses[gradient]} relative overflow-hidden min-h-[140px] flex items-end`}>
    <div class="pac-header-blob absolute top-[-30px] right-[-30px] w-72 h-72 rounded-full bg-white/10" />
    <div class="pac-header-title font-heading text-xl font-extrabold text-white relative z-10">{title}</div>
    <i class={`pac-header-icon text-3xl text-white/70 absolute top-5 right-5 z-10 fas ${icon}`}></i>
  </div>
  <div class="pac-body p-6 bg-white">
    <p class="text-sm text-[#8898aa] leading-relaxed mb-5">{description}</p>
    <a href={href} class={`btn ${buttonClasses[gradient]} btn-round btn-sm`} target="_blank" rel="noopener noreferrer">
      {buttonIcon && <i class={`fas ${buttonIcon} mr-2`}></i>}
      {buttonText}
    </a>
  </div>
</div>