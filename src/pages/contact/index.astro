---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
---

<BaseLayout 
  title="Contact Us" 
  description="Get in touch with Morgan Zintec College. Visit our campus in Arcadia, Harare or contact us via phone, email, or WhatsApp."
  image="/images/og-contact.jpg"
>
  <Navbar currentPage="contact" slot="header" />
  
  <Hero
    title="Contact Us"
    variant="page"
    description="We'd love to hear from you. Reach us at our campus in Arcadia, Harare or through any of the channels below."
    primaryCTA={{ label: "Call Us", href: "tel:+263242771190", icon: "fa-phone" }}
    secondaryCTA={{ label: "WhatsApp", href: "https://wa.me/2630714572766", icon: "fa-whatsapp" }}
  />

  <section class="py-16 bg-white">
    <div class="container">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h3 class="font-display text-2xl font-bold text-mzc-navy mb-6">Get In Touch</h3>
          <p class="text-[#8898aa] leading-relaxed mb-8">Whether you're a prospective student, parent, partner, or alumnus, we're here to help. Choose the most convenient way to reach us.</p>
          
          <div class="space-y-6">
            {[
              { icon: "fa-map-marker-alt", title: "Visit Our Campus", details: ["1 Alamein Road, Arcadia", "PO Box 1700, Harare, Zimbabwe"], color: "text-mzc-blue" },
              { icon: "fa-envelope", title: "Email Us", details: ["secretary@morganzintec.ac.zw", "info@morganzintec.ac.zw"], color: "text-mzc-teal" },
              { icon: "fa-phone", title: "Call Us", details: ["+263 242 771 190", "+263 868 800 7100"], color: "text-[#2DCE89]" },
              { icon: "fa-whatsapp", title: "WhatsApp", details: ["0714 572 766"], color: "text-[#25D366]" },
              { icon: "fa-clock", title: "Office Hours", details: ["Monday – Friday: 9:00 – 16:30", "Closed on Public Holidays"], color: "text-[#FB6340]" }
            ].map((item, i) => (
              <div key={i} class="flex gap-4 p-4 bg-[#F8F9FE] rounded-xl hover:bg-[#EEF0F8] transition-colors">
                <div class={`icon-box icon-box-lg flex-shrink-0 ${item.color.replace('text-', 'bg-').replace('text-', '').replace('bg-', '')}/10 ${item.color.replace('text-', 'text-')}`}>
                  <i class={`fas ${item.icon}`}></i>
                </div>
                <div>
                  <h4 class="font-heading font-bold text-mzc-navy mb-1">{item.title}</h4>
                  <div class="text-sm text-[#8898aa] leading-relaxed space-y-0.5">
                    {item.details.map((detail, j) => <p key={j}>{detail}</p>)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="bg-[#F8F9FE] rounded-2xl p-8">
          <h3 class="font-display text-2xl font-bold text-mzc-navy mb-6">Send Us a Message</h3>
          <form class="space-y-5" id="contactForm" action="https://formspree.io/f/your-form-id" method="POST">
            <div class="grid md:grid-cols-2 gap-5">
              <div>
                <label for="firstName" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">First Name *</label>
                <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all placeholder:text-gray-400" placeholder="Tonderayi" />
              </div>
              <div>
                <label for="lastName" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">Last Name *</label>
                <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all placeholder:text-gray-400" placeholder="Zendah" />
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">Email Address *</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all placeholder:text-gray-400" placeholder="tonderayi@example.com" />
              </div>
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all placeholder:text-gray-400" placeholder="+263 7X XXX XXX" />
              </div>
            </div>
            <div>
              <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">Subject *</label>
              <select id="subject" name="subject" required class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all appearance-none">
                <option value="">Select a subject</option>
                <option value="admissions">Admissions & Enrolment</option>
                <option value="academics">Academic Programmes</option>
                <option value="research">Research & Innovation</option>
                <option value="library">Library Services</option>
                <option value="partnerships">Partnerships & Collaborations</option>
                <option value="alumni">Alumni Relations</option>
                <option value="general">General Enquiry</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-[#8898aa] mb-1">Message *</label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 bg-white border border-gray-200 rounded-lg text-sm text-[#333] focus:outline-none focus:ring-2 focus:ring-mzc-blue focus:border-transparent transition-all placeholder:text-gray-400 resize-y" placeholder="How can we help you?"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-round w-full md:w-auto py-3 px-8">
              <i class="fas fa-paper-plane mr-2"></i> Send Message
            </button>
            <p class="text-xs text-[#8898aa] text-center md:text-left">By submitting this form, you agree to our <a href="#" class="text-mzc-blue hover:underline">Privacy Policy</a>.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map/Location Section -->
  <section class="py-16 bg-[#F8F9FE]">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h3 class="font-display text-2xl font-bold text-mzc-navy mb-2">Find Us</h3>
          <p class="text-[#8898aa]">Our campus is located in the heart of Arcadia, Harare</p>
        </div>
        <div class="aspect-video rounded-2xl overflow-hidden shadow-xl bg-gray-200 relative">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3694.5!2d31.05!3d-17.83!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1931a3b8b8b8b8b%3A0xb8b8b8b8b8b8b8b8!2sMorgan%20Zintec%20College!5e0!3m2!1sen!2szw!4v1234567890!5m2!1sen!2szw" 
            class="absolute inset-0 w-full h-full border-0" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Morgan Zintec College Location"
          ></iframe>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end p-4 text-white pointer-events-none">
            <div>
              <p class="font-heading font-bold">Morgan Zintec College</p>
              <p class="text-sm opacity-90">1 Alamein Rd, Arcadia, Harare, Zimbabwe</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';
        btn.disabled = true;
        
        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });
          
          if (response.ok) {
            btn.innerHTML = '<i class="fas fa-check mr-2"></i> Sent Successfully!';
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-secondary');
            form.reset();
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          btn.innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i> Error - Try Again';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-warning');
        }
        
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          btn.classList.remove('btn-secondary', 'btn-warning');
          btn.classList.add('btn-primary');
        }, 3000);
      });
    }
  });
</script>