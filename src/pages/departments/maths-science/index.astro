---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
---

<BaseLayout 
  title="Maths & Sciences Department" 
  description="Department of Maths & Sciences at Morgan Zintec College - STEM education, Mathematics, Science, and Environmental Science sections."
  image="/images/og-maths-science.jpg"
>
  <Navbar currentPage="departments" slot="header" />
  
  <Hero
    title="Maths & Sciences"
    variant="page"
    badge="Department"
    badgeIcon="fa-calculator"
    description="Covers Mathematics, Science and related STEM areas preparing student teachers to effectively teach at the primary school level. Focuses on inquiry-based learning, practical skills and problem-solving pedagogy."
    primaryCTA={{ label: "View All Departments", href: "/departments/", icon: "fa-building" }}
    secondaryCTA={{ label: "Contact Department", href: "/contact/", icon: "fa-envelope" }}
  />

  <section class="py-12 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center mb-16">
        <div class="section-label">Department of Maths & Sciences</div>
        <h2 class="section-title font-display">Department Overview</h2>
        <div class="divider divider-center mb-6"></div>
        <p class="text-lg text-[#8898aa] leading-relaxed">The Department of Mathematics and Sciences is dedicated to producing competent primary school teachers with strong foundations in mathematical and scientific thinking. The department emphasises hands-on learning, inquiry-based approaches, and the integration of technology in STEM education.</p>
      </div>
      
      <div class="hod-header flex items-center gap-5 bg-[#F5F7FA] rounded-xl p-6 mb-12 border-l-5 border-[#2DCE89] max-w-2xl mx-auto">
        <div class="hod-avatar w-16 h-16 rounded-full bg-gradient-to-br from-[#1A3A2A] to-[#2D6A4A] flex items-center justify-center text-3xl text-white/30 flex-shrink-0 border-3 border-mzc-teal">👤</div>
        <div class="hod-info">
          <h4 class="font-heading font-extrabold text-lg text-mzc-navy mb-1">[To be updated]</h4>
          <p class="text-xs font-bold text-mzc-teal uppercase tracking-wider">Head of Department — Maths & Sciences</p>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        {[
          { title: "Mathematics PSB", desc: "Professional Studies Syllabus B covering pedagogy, methodology, and content knowledge for teaching mathematics at primary level.", icon: "fa-square-root-variable", color: "icon-box-primary" },
          { title: "Mathematics Main Subject", desc: "In-depth mathematical content for student teachers specialising in mathematics, including algebra, geometry, statistics, and calculus foundations.", icon: "fa-calculator", color: "icon-box-teal" },
          { title: "Science PSB", desc: "Professional Studies Syllabus B for science education covering biology, chemistry, physics, and integrated science pedagogy.", icon: "fa-flask", color: "icon-box-success" },
          { title: "Science Main Subject", desc: "Advanced science content specialisation for primary teachers focusing on scientific inquiry, experimentation, and curriculum delivery.", icon: "fa-atom", color: "icon-box-warning" },
          { title: "Environmental Science", desc: "Interdisciplinary approach to environmental education, sustainability, climate change, and local ecological systems.", icon: "fa-leaf", color: "icon-box-gold" }
        ].map((section, i) => (
          <div key={i} class="bg-white rounded-xl p-6 shadow-[0_2px_14px_rgba(0,0,0,.07)] hover:shadow-[0_8px_28px_rgba(0,0,0,.1)] transition-all border-t-4 border-[#2DCE89]">
            <div class="icon-box-lg mb-4 {section.color}"><i class={`fas ${section.icon}`}></i></div>
            <h4 class="font-heading font-extrabold text-base text-mzc-navy mb-2">{section.title}</h4>
            <p class="text-sm text-[#666] leading-relaxed">{section.desc}</p>
          </div>
        ))}
      </div>
      
      <div class="bg-gradient-to-br from-[#1A3A2A] to-[#2D6A4A] rounded-2xl p-8 text-white text-center">
        <h3 class="font-display text-2xl font-bold mb-4">STEM Education Excellence</h3>
        <p class="text-white/80 leading-relaxed mb-6 max-w-2xl mx-auto">Our department is committed to developing 21st-century STEM educators who can inspire the next generation of Zimbabwean scientists, engineers, and innovators.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/academics/" class="btn btn-white btn-round"><i class="fas fa-graduation-cap mr-2"></i> View Programmes</a>
          <a href="/contact/" class="btn btn-outline-white btn-round"><i class="fas fa-envelope mr-2"></i> Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer variant="dark" slot="footer" />
</BaseLayout>