<script>
  // Programme tabs
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.prog-tab-btn');
    const contents = document.querySelectorAll('.prog-tab-content');
    
    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        tabs.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.add('hidden'));
        btn.classList.add('active');
        document.getElementById(tab)?.classList.remove('hidden');
      });
    });
  });
</script>

<style>
  .prog-tab-btn.active {
    @apply bg-gradient-to-r from-mzc-blue to-[#1C90D8] text-white shadow-[0_4px_6px_rgba(50,50,93,.11),0_1px_3px_rgba(0,0,0,.08)];
  }
  .prog-tab-content {
    @apply hidden;
  }
  .prog-tab-content:not(.hidden) {
    @apply block;
  }
</style>